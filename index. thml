<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kisan Anaj Bazaar</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f5f6f8;
  color:#222;
}
header{
  position:sticky;
  top:0;
  z-index:100;
  background:white;
  border-bottom:1px solid #ddd;
}
.top{
  display:flex;
  align-items:center;
  gap:10px;
  padding:12px;
}
.logo{
  color:#16833a;
  font-size:20px;
  font-weight:bold;
}
.search{
  flex:1;
  padding:11px;
  border:1px solid #ccc;
  border-radius:8px;
}
nav{
  display:flex;
  overflow-x:auto;
  border-top:1px solid #eee;
}
nav button{
  min-width:100px;
  padding:13px 8px;
  border:0;
  background:white;
  font-weight:bold;
}
nav button.active{
  color:#16833a;
  border-bottom:3px solid #16833a;
}
main{
  max-width:1100px;
  margin:auto;
  padding:15px;
}
.page{display:none}
.page.active{display:block}

.hero{
  background:#eaf8ee;
  padding:25px;
  border-radius:15px;
  margin-bottom:20px;
}
.hero h1{margin-top:0}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
  gap:15px;
}
.card{
  background:white;
  border:1px solid #ddd;
  border-radius:12px;
  overflow:hidden;
}
.card img{
  width:100%;
  height:160px;
  object-fit:cover;
  background:#eee;
}
.card-body{
  padding:12px;
}
.price{
  font-size:20px;
  font-weight:bold;
}
.muted{
  color:#666;
  font-size:13px;
}
.form{
  background:white;
  padding:18px;
  border-radius:12px;
  border:1px solid #ddd;
  max-width:650px;
}
input,textarea,select{
  width:100%;
  padding:11px;
  margin:6px 0 13px;
  border:1px solid #ccc;
  border-radius:8px;
}
label{
  font-weight:bold;
  font-size:14px;
}
.primary{
  background:#16833a;
  color:white;
  border:0;
  border-radius:8px;
  padding:11px 15px;
  font-weight:bold;
}
.secondary{
  background:white;
  color:#16833a;
  border:1px solid #16833a;
  border-radius:8px;
  padding:10px 14px;
  font-weight:bold;
}
.row{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}
.order{
  background:white;
  border:1px solid #ddd;
  border-radius:12px;
  padding:15px;
  margin-bottom:12px;
}
.status{
  display:inline-block;
  background:#eaf7ed;
  color:#16833a;
  padding:5px 9px;
  border-radius:20px;
  font-size:12px;
}
.empty{
  background:white;
  padding:30px;
  text-align:center;
  border-radius:12px;
}
footer{
  text-align:center;
  padding:30px;
  color:#777;
}

@media(max-width:600px){
  .top{flex-wrap:wrap}
  .search{
    flex-basis:100%;
    order:3;
  }
  .grid{
    grid-template-columns:repeat(2,1fr);
  }
  .card img{
    height:125px;
  }
}
</style>
</head>

<body>

<header>

<div class="top">
  <div class="logo">🌾 Kisan Anaj Bazaar</div>

  <input
    id="search"
    class="search"
    placeholder="सामान खोजें..."
    oninput="renderProducts()"
  >
</div>

<nav>

<button data-page="home"
onclick="showPage('home')">
🏠 Home
</button>

<button data-page="buy"
onclick="showPage('buy')">
🛒 खरीदें
</button>

<button data-page="sell"
onclick="showPage('sell')">
📦 बेचें
</button>

<button data-page="orders"
onclick="showPage('orders')">
📋 Orders
</button>

<button data-page="chat"
onclick="showPage('chat')">
💬 Chat
</button>

<button data-page="account"
onclick="showPage('account')">
👤 Account
</button>

</nav>

</header>


<main>

<!-- HOME -->

<section id="home" class="page active">

<div class="hero">

<h1>Kisan Anaj Bazaar</h1>

<p>
किसान और ग्राहक एक ही जगह सामान खरीद और बेच सकते हैं।
</p>

<div class="row">

<button class="primary"
onclick="showPage('buy')">
🛒 सामान खरीदें
</button>

<button class="secondary"
onclick="showPage('sell')">
📦 सामान बेचें
</button>

</div>

</div>

<h2>🔥 उपलब्ध सामान</h2>

<div id="homeProducts" class="grid"></div>

</section>


<!-- BUY -->

<section id="buy" class="page">

<h2>🛒 सामान खरीदें</h2>

<div id="buyProducts" class="grid"></div>

</section>


<!-- SELL -->

<section id="sell" class="page">

<h2>📦 सामान बेचें</h2>

<form
class="form"
onsubmit="addProduct(event)"
>

<label>Product का नाम</label>

<input
id="pname"
required
placeholder="जैसे आलू, गेहूँ, धान"
>


<label>कीमत ₹</label>

<input
id="pprice"
type="number"
required
placeholder="34"
>


<label>Quantity</label>

<input
id="pqty"
type="number"
required
placeholder="100"
>


<label>Unit</label>

<select id="punit">

<option>किलो</option>
<option>क्विंटल</option>
<option>टन</option>
<option>पीस</option>

</select>


<label>Location</label>

<input
id="plocation"
placeholder="गाँव / शहर"
>


<label>Product Photo</label>

<input
id="pimage"
type="file"
accept="image/*"
>


<label>Description</label>

<textarea
id="pdesc"
rows="4"
placeholder="सामान की जानकारी"
></textarea>


<button class="primary">

📤 Product Upload करें

</button>

</form>

</section>


<!-- PRODUCT -->

<section id="product" class="page">

<div id="productDetail"></div>

</section>


<!-- CHECKOUT -->

<section id="checkout" class="page">

<h2>🧾 Order करें</h2>

<div id="checkoutBox"></div>

</section>


<!-- ORDERS -->

<section id="orders" class="page">

<h2>📋 My Orders</h2>

<div id="ordersList"></div>

</section>


<!-- CHAT -->

<section id="chat" class="page">

<h2>💬 Chat</h2>

<div class="form">

<div
id="messages"
style="
height:220px;
overflow:auto;
border:1px solid #ddd;
padding:10px;
margin-bottom:10px;
"
></div>

<input
id="chatText"
placeholder="Message लिखें..."
>

<button
class="primary"
onclick="sendMessage()"
>
Send
</button>

</div>

</section>


<!-- ACCOUNT -->

<section id="account" class="page">

<h2>👤 Account</h2>

<div class="form">

<label>नाम</label>

<input
id="accountName"
placeholder="अपना नाम"
>


<label>Mobile</label>

<input
id="accountPhone"
placeholder="मोबाइल नंबर"
>


<label>Delivery Address</label>

<textarea
id="accountAddress"
rows="4"
placeholder="पूरा पता"
></textarea>


<button
class="primary"
onclick="saveAccount()"
>
Save Account
</button>

<p id="accountMsg"></p>

</div>

</section>


<!-- HELP -->

<section id="help" class="page">

<h2>📞 Buy Order सहायता</h2>

<div class="form">

<input
id="helpOrder"
placeholder="Order ID"
>

<textarea
id="helpText"
rows="4"
placeholder="समस्या लिखें"
></textarea>

<button
class="primary"
onclick="submitHelp()"
>
सहायता भेजें
</button>

<p id="helpMsg"></p>

</div>

</section>

</main>


<footer>

Kisan Anaj Bazaar © 2026

</footer>


<script>

/* ============================
   DATABASE - TEMPORARY LOCAL
   बाद में Firebase से connect होगा
============================ */

const PRODUCTS_KEY="KAB_PRODUCTS";
const ORDERS_KEY="KAB_ORDERS";
const ACCOUNT_KEY="KAB_ACCOUNT";
const CHAT_KEY="KAB_CHAT";


let products =
JSON.parse(localStorage.getItem(PRODUCTS_KEY) || "null")
||
[
{
id:"P1001",
name:"आलू",
price:34,
qty:100,
unit:"किलो",
location:"हरियाणा",
desc:"ताजा आलू",
seller:"Demo Seller",
image:"https://images.unsplash.com/photo-1518977676601-b53f82aba655?auto=format&fit=crop&w=700&q=80"
}
];


let orders =
JSON.parse(localStorage.getItem(ORDERS_KEY) || "[]");


let account =
JSON.parse(localStorage.getItem(ACCOUNT_KEY) || "{}");


let messages =
JSON.parse(localStorage.getItem(CHAT_KEY) || "[]");


let selectedProduct=null;


/* SAVE */

function saveData(){

localStorage.setItem(
PRODUCTS_KEY,
JSON.stringify(products)
);

localStorage.setItem(
ORDERS_KEY,
JSON.stringify(orders)
);

localStorage.setItem(
ACCOUNT_KEY,
JSON.stringify(account)
);

localStorage.setItem(
CHAT_KEY,
JSON.stringify(messages)
);

}


/* PAGE NAVIGATION */

function showPage(page){

document
.querySelectorAll(".page")
.forEach(x=>x.classList.remove("active"));

document
.getElementById(page)
.classList.add("active");


document
.querySelectorAll("nav button")
.forEach(x=>{
x.classList.toggle(
"active",
x.dataset.page===page
);
});


if(page==="home" || page==="buy")
renderProducts();

if(page==="orders")
renderOrders();

if(page==="account")
loadAccount();

if(page==="chat")
renderChat();

window.scrollTo({
top:0,
behavior:"smooth"
});

}


/* PRODUCT LIST */

function renderProducts(){

let search=
document.getElementById("search")
.value
.toLowerCase();


let list=
products.filter(p=>
(
p.name+
" "+
p.location+
" "+
p.desc
)
.toLowerCase()
.includes(search)
);


let html=list.length
?
list.map(productCard).join("")
:
`
<div class="empty">
अभी कोई सामान उपलब्ध नहीं है।
</div>
`;


document.getElementById(
"homeProducts"
).innerHTML=html;


document.getElementById(
"buyProducts"
).innerHTML=html;

}


/* PRODUCT CARD */

function productCard(p){

return `

<div class="card">

<img
src="${p.image}"
alt="${esc(p.name)}"
>

<div class="card-body">

<div class="muted">
${esc(p.location)}
</div>

<h3>
${esc(p.name)}
</h3>

<div class="price">
₹${Number(p.price).toLocaleString("en-IN")}
</div>

<div class="muted">
${esc(p.qty)}
${esc(p.unit)}
available
</div>

<p>
${esc(p.desc)}
</p>

<button
class="primary"
onclick="openProduct('${p.id}')"
>
देखें / Buy
</button>

</div>

</div>

`;

}


/* OPEN PRODUCT */

function openProduct(id){

selectedProduct=
products.find(p=>p.id===id);

if(!selectedProduct)
return;


document.getElementById(
"productDetail"
).innerHTML=

`

<button
class="secondary"
onclick="showPage('buy')"
>
← वापस
</button>

<div
class="card"
style="margin-top:15px;max-width:650px"
>

<img
src="${selectedProduct.image}"
style="height:280px"
>

<div class="card-body">

<h2>
${esc(selectedProduct.name)}
</h2>

<div class="price">
₹${selectedProduct.price}
</div>

<p>
${esc(selectedProduct.desc)}
</p>

<p>
Quantity:
${selectedProduct.qty}
${selectedProduct.unit}
</p>

<p>
Location:
${esc(selectedProduct.location)}
</p>

<button
class="primary"
onclick="startCheckout('${selectedProduct.id}')"
>
🛒 Buy Now
</button>

<button
class="secondary"
onclick="showPage('chat')"
>
💬 Chat
</button>

</div>

</div>

`;

showPage("product");

}


/* CHECKOUT */

function startCheckout(id){

selectedProduct=
products.find(p=>p.id===id);


document.getElementById(
"checkoutBox"
).innerHTML=

`

<div class="form">

<h3>
${esc(selectedProduct.name)}
</h3>

<label>
Quantity
</label>

<input
id="buyQty"
type="number"
min="1"
max="${selectedProduct.qty}"
value="1"
oninput="calcTotal()"
>

<label>
Delivery Address
</label>

<textarea
id="buyAddress"
rows="4"
>${esc(account.address || "")}</textarea>

<p>
Product:
₹<span id="productTotal">
${selectedProduct.price}
</span>
</p>

<p>
Delivery:
₹<span id="deliveryCharge">
50
</span>
</p>

<h3>
Total:
₹<span id="grandTotal">
${selectedProduct.price+50}
</span>
</h3>

<button
class="primary"
onclick="placeOrder()"
>
💳 Payment करके Order करें
</button>

</div>

`;

showPage("checkout");

calcTotal();

}


/* TOTAL */

function calcTotal(){

if(!selectedProduct)
return;


let qty=
Number(
document.getElementById("buyQty").value
||1
);


let subtotal=
selectedProduct.price*qty;


let delivery=
subtotal>=1000
?0
:50;


document.getElementById(
"productTotal"
).textContent=subtotal;


document.getElementById(
"deliveryCharge"
).textContent=delivery;


document.getElementById(
"grandTotal"
).textContent=
subtotal+delivery;

}


/* ORDER */

function placeOrder(){

let qty=
Number(
document.getElementById("buyQty").value
);


let address=
document.getElementById(
"buyAddress"
).value.trim();


if(!address){

alert(
"पहले Delivery Address डालें"
);

return;

}


if(
qty<1 ||
qty>selectedProduct.qty
){

alert(
"Available quantity से ज्यादा नहीं खरीद सकते"
);

return;

}


let subtotal=
selectedProduct.price*qty;


let delivery=
subtotal>=1000
?0
:50;


let order={

id:"ORD"+Date.now(),

productId:selectedProduct.id,

productName:selectedProduct.name,

seller:selectedProduct.seller,

quantity:qty,

unit:selectedProduct.unit,

subtotal:subtotal,

deliveryCharge:delivery,

total:subtotal+delivery,

address:address,

status:"Pending Payment",

paymentStatus:"Pending",

deliveryPartner:"Not Assigned",

date:new Date().toLocaleString("hi-IN")

};


/*
================================================
PAYMENT API CONNECTION

यहाँ तुम्हारा existing payment API connect होगा.

IMPORTANT:
Secret API key को इस HTML में मत डालना.

Secure backend/Firebase Function से payment
create करके success होने पर order को Paid करना है.
================================================
*/


orders.unshift(order);

selectedProduct.qty-=qty;

saveData();


alert(
"Order बन गया। Payment API connect होने के बाद payment confirmation यहाँ आएगा।"
);


showPage("orders");

}


/* ORDERS */

function renderOrders(){

let box=
document.getElementById("ordersList");


if(!orders.length){

box.innerHTML=
`
<div class="empty">
अभी कोई Order नहीं है।
</div>
`;

return;

}


box.innerHTML=
orders.map(o=>

`

<div class="order">

<h3>
${esc(o.productName)}
</h3>

<p>
Order ID:
<b>${o.id}</b>
</p>

<p>
Quantity:
${o.quantity} ${esc(o.unit)}
</p>

<p>
Total:
<b>₹${o.total}</b>
</p>

<p>
Payment:
<span class="status">
${esc(o.paymentStatus)}
</span>
</p>

<p>
Order Status:
<span class="status">
${esc(o.status)}
</span>
</p>

<p>
Delivery:
${esc(o.deliveryPartner)}
</p>

<p>
Address:
${esc(o.address)}
</p>

<small>
${esc(o.date)}
</small>

</div>

`

).join("");

}


/* SELL PRODUCT */

function addProduct(event){

event.preventDefault();


let file=
document.getElementById(
"pimage"
).files[0];


let product={

id:"P"+Date.now(),

name:
document.getElementById("pname").value,

price:
Number(
document.getElementById("pprice").value
),

qty:
Number(
document.getElementById("pqty").value
),

unit:
document.getElementById("punit").value,

location:
document.getElementById("plocation").value,

desc:
document.getElementById("pdesc").value,

seller:
account.name || "Seller",

image:""

};


function finish(image){

product.image=
image ||
"https://via.placeholder.com/700x500?text=Product";


products.unshift(product);

saveData();

event.target.reset();

alert(
"आपका सामान सफलतापूर्वक upload हो गया।"
);

showPage("buy");

}


if(file){

let reader=
new FileReader();

reader.onload=function(){

finish(reader.result);

};

reader.readAsDataURL(file);

}else{

finish("");

}

}


/* ACCOUNT */

function loadAccount(){

document.getElementById(
"accountName"
).value=
account.name || "";

document.getElementById(
"accountPhone"
).value=
account.phone || "";

document.getElementById(
"accountAddress"
).value=
account.address || "";

}


function saveAccount(){

account={

name:
document.getElementById(
"accountName"
).value,

phone:
document.getElementById(
"accountPhone"
).value,

address:
document.getElementById(
"accountAddress"
).value

};


saveData();


document.getElementById(
"accountMsg"
).textContent=
"Account save हो गया।";

}


/* CHAT */

function renderChat(){

let box=
document.getElementById(
"messages"
);


if(!messages.length){

box.innerHTML=
"<p class='muted'>अभी कोई message नहीं है।</p>";

return;

}


box.innerHTML=
messages.map(m=>

`
<p>
<b>${esc(m.from)}:</b>
${esc(m.text)}
</p>
`

).join("");

}


function sendMessage(){

let input=
document.getElementById(
"chatText"
);


let text=input.value.trim();


if(!text)
return;


messages.push({

from:
account.name || "User",

text:text,

time:Date.now()

});


saveData();

input.value="";

renderChat();

}


/* HELP */

function submitHelp(){

let order=
document.getElementById(
"helpOrder"
).value.trim();


let problem=
document.getElementById(
"helpText"
).value.trim();


if(!order || !problem){

alert(
"Order ID और समस्या भरें"
);

return;

}


document.getElementById(
"helpMsg"
).textContent=
"आपकी सहायता request दर्ज हो गई।";

}


/* SECURITY */

function esc(value){

return String(value ?? "")
.replace(
/[&<>"']/g,
function(c){

return {

"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#39;"

}[c];

}
);

}


/* START */

renderProducts();

loadAccount();

</script>

</body>
</html>