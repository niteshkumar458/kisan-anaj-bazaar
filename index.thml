selectedProduct.phone,

buyer:
buyerName,

buyerPhone:
buyerPhone,

buyerLocation:
buyerLocation,

quantity:
qty,

unit:
selectedProduct.unit,

itemAmount:
itemAmount,

commission:
commission,

cashbackEarned:
earnedCashback,

cashbackUsed:
cashbackUsed,

onlineDiscount:
discount,

finalAmount:
finalAmount,

paymentMethod:
paymentMethod,

paymentStatus:
paymentMethod==="online"
?
"Payment Pending"
:
"Cash Payment Pending",

cashbackStatus:
"Available for next purchase",

orderStatus:
"Order Placed",

merchantUPI:
MERCHANT_UPI

};


orders.unshift(order);


selectedProduct.qty -= qty;


cashbackHistory.unshift({

id:order.id,

date:order.date,

type:"earned",

amount:earnedCashback,

message:
"इस ऑर्डर पर 1% Cashback मि